# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it is gitignored.
# NOTE: do NOT prefix RESEND_* with VITE_ — that would expose them in the browser bundle.

# Resend API key (from https://resend.com/api-keys) — used ONLY by the server (Render)
RESEND_API_KEY=

# Where contact-form emails should be delivered
CONTACT_EMAIL=

# Frontend talks to the API. In dev it's the local server; in prod set this in
# Vercel to your Render URL, e.g. https://rachit-portfolio-api.onrender.com
# VITE_API_URL starts with VITE_ on purpose — the browser needs this one.
VITE_API_URL=http://localhost:3001

# Render API key (created in render.com → Account Settings → API Keys).
# Used ONLY by the deploy tooling, NOT by the app at runtime. Store in .env.
RENDER_API_KEY=